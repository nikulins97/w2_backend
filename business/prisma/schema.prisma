generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Ad {
  id              String   @id @default(uuid())
  sourceUrl       String   @unique
  createdByUserId Int?
  brand           String?
  model           String?
  year            Int?
  mileage         Int?
  price           Float?
  currency        String?
  fuel            String?
  transmission    String?
  bodyType        String?
  vin             String?
  site            String?
  parserVersion   String?
  rawPayload      String?
  parsedAt        DateTime?
  lastFetchedAt   DateTime @updatedAt
  createdAt       DateTime @default(now())

  @@map("ads")
}
