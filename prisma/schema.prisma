generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id      Int    @id @default(autoincrement())
  name    String
  surname String
  login   String @unique
  password String
  role  String @default("EMPLOYEE")
  refreshToken String?

  @@map("users")
}
